//===========================================================================
// Trigger: add skills
//===========================================================================
function Trig_add_skills_Conditions takes nothing returns boolean
    if ( not ( GetItemTypeId(GetManipulatedItem()) == 'I000' ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_add_skills_Func002C takes nothing returns boolean
    if ( not ( GetUnitAbilityLevelSwapped('A000', GetTriggerUnit()) == 0 ) ) then
        return false
    endif
    if ( not ( GetUnitAbilityLevelSwapped('A000', GetTriggerUnit()) < 50 ) ) then
        return false
    endif
    return true
endfunction

function Trig_add_skills_Actions takes nothing returns nothing
    if ( Trig_add_skills_Func002C() ) then
        call CreateTextTagLocBJ( "TRIGSTR_017", GetRectCenter(GetPlayableMapRect()), 0, 300.00, 100, 100, 100, 50.00 )
        call UnitAddAbilityBJ( 'A000', GetTriggerUnit() )
        call UnitAddAbilityBJ( 'A003', GetTriggerUnit() )
        call UnitAddAbilityBJ( 'A002', GetTriggerUnit() )
    else
        call IncUnitAbilityLevelSwapped( 'A003', GetTriggerUnit() )
        call IncUnitAbilityLevelSwapped( 'A002', GetTriggerUnit() )
        call CreateTextTagLocBJ( "TRIGSTR_016", GetRectCenter(GetPlayableMapRect()), 0, 10, 100, 100, 100, 50.00 )
    endif
endfunction

//===========================================================================
function InitTrig_add_skills takes nothing returns nothing
    set gg_trg_add_skills = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_add_skills, EVENT_PLAYER_UNIT_PICKUP_ITEM )
    call TriggerAddCondition( gg_trg_add_skills, Condition( function Trig_add_skills_Conditions ) )
    call TriggerAddAction( gg_trg_add_skills, function Trig_add_skills_Actions )
endfunction

//===========================================================================
// Trigger: improve tech
//===========================================================================
function Trig_improve_tech_Conditions takes nothing returns boolean
    if ( not ( GetItemTypeId(GetManipulatedItem()) == 'I000' ) ) then
        return false
    endif
    if ( not ( IsUnitType(GetTriggerUnit(), UNIT_TYPE_HERO) == true ) ) then
        return false
    endif
    return true
endfunction

function Trig_improve_tech_Func002C takes nothing returns boolean
    if ( not ( GetPlayerTechCountSimple('R000', GetTriggerPlayer()) < 50 ) ) then
        return false
    endif
    return true
endfunction

function Trig_improve_tech_Actions takes nothing returns nothing
    if ( Trig_improve_tech_Func002C() ) then
        call SetPlayerTechResearchedSwap( 'R000', ( GetPlayerTechCountSimple('R000', GetTriggerPlayer()) + 1 ), GetTriggerPlayer() )
    else
        call DoNothing(  )
    endif
endfunction

//===========================================================================
function InitTrig_improve_tech takes nothing returns nothing
    set gg_trg_improve_tech = CreateTrigger(  )
    call TriggerRegisterAnyUnitEventBJ( gg_trg_improve_tech, EVENT_PLAYER_UNIT_PICKUP_ITEM )
    call TriggerAddCondition( gg_trg_improve_tech, Condition( function Trig_improve_tech_Conditions ) )
    call TriggerAddAction( gg_trg_improve_tech, function Trig_improve_tech_Actions )
endfunction

//===========================================================================
function InitCustomTriggers takes nothing returns nothing
    call InitTrig_add_skills(  )
    call InitTrig_improve_tech(  )
endfunction

